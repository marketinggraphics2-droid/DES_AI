# ======================================================================
#  LINKS — where the chatbot lives
# ======================================================================
# Public HTTPS address of this backend once deployed (DigitalOcean), e.g. https://chat.dynamiqes.com
# Leave empty for local dev. The server prints the WordPress embed snippet from it on start.
PUBLIC_URL=
# The WordPress site that shows the widget (added to ALLOWED_ORIGINS automatically)
WEBSITE_URL=https://stg-dynamiqescom-staging.kinsta.cloud
# Other sites/pages allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://dynamiqes.com,https://stg-dynamiqescom-staging.kinsta.cloud,http://localhost:8767,http://localhost:8787
# Site the knowledge base is read from (keep production — staging may have draft content)
SITE_ORIGIN=https://dynamiqes.com
SITEMAP_URL=https://dynamiqes.com/sitemap_index.xml

# ======================================================================
#  API KEYS — paste here, never commit (this file is git-ignored)
# ======================================================================
# IQGateway key (IQLicense → API keys, starts with gws_). Bound to one client + product wallet.
# Empty = MOCK mode (canned answers)
IQ_GATEWAY_KEY=
# Voyage AI embeddings (dash.voyageai.com). Also set EMBEDDINGS_PROVIDER=voyage below
VOYAGE_API_KEY=
# Cloudflare Turnstile secret (bot check on "I agree"). Empty = skipped (dev only)
TURNSTILE_SECRET=
# Email for consultant handoffs. Empty SMTP_HOST = emails printed to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- server ----
PORT=8787
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-admin-bearer-token          # temporary admin auth until Google SSO is wired

# ---- database ----
# zero-install local dev: embedded Postgres (PGlite + pgvector) stored in ./data/pglite
DATABASE_URL=pglite:./data/pglite
# OneDrive users: keep the DB OUTSIDE the synced folder or OneDrive sync corrupts it, e.g.
# DATABASE_URL=pglite:C:/Users/<you>/AppData/Local/des-chat/pglite
# docker-compose / DigitalOcean managed Postgres:
# DATABASE_URL=postgres://des:des@localhost:5433/des

# ---- LLM via IQGateway (OpenAI-compatible) ----
IQ_GATEWAY_URL=https://iqlicense.dynamiqes.com/v1
IQ_GATEWAY_PROVIDER=gemini      # Gemini only (blank = infer from model name)
IQ_GATEWAY_ANTHROPIC_CACHE=true  # only used for claude-* models
IQ_GATEWAY_TIMEOUT_MS=60000
MODEL=gemini-3.5-flash-lite       # chat answers
GUARD_MODEL=gemini-3.5-flash-lite # summaries / classifier
EFFORT=low                       # only used for claude-* and gpt-5/o models; ignored for Gemini
GEMINI_THINKING_LEVEL=minimal    # gemini-3.x: minimal | low | medium | high (minimal = fastest, cheapest)
GOLDEN_MIN_SCORE=0.5             # approved answers: minimum match score 0-1 (higher = stricter)
MAX_OUTPUT_TOKENS=600
DAILY_BUDGET_USD=20              # bot switches to lead-form mode at 100 %

# ---- embeddings: voyage (recommended) or hash (offline fallback, dev only) ----
EMBEDDINGS_PROVIDER=hash
VOYAGE_MODEL=voyage-3-lite
EMBEDDING_DIM=1024

# ---- anti-abuse ----
RATE_MSG_PER_10MIN=30
RATE_MSG_PER_DAY=80
RATE_SESSIONS_PER_IP_DAY=5
RATE_SESSIONS_PER_CONTACT_DAY=3
MAX_TURNS_PER_CONVERSATION=40
CHAT_STRIKES_MAX=3               # off-topic / abusive messages before DES ends the chat
CHAT_BAN_HOURS=24                # after an ended chat: device, visitor and contact are blocked this long
CHAT_BAN_IP_HOURS=1              # ...and the internet connection this long (an office shares one)

# ---- handoff / email (console transport when SMTP_HOST empty) ----
SALES_EMAIL=sales@dynamiqes.com
MAIL_FROM="DES <no-reply@dynamiqes.com>"

# ---- knowledge base ----
WP_WEBHOOK_SECRET=change-me-shared-with-wordpress
SCRAPE_DIR=../reference/website-scrape-2026-10-01

# ---- privacy ----
CONSENT_VERSION=2026-10-01
RETENTION_MONTHS=12
PII_ENCRYPTION_KEY=              # 32-byte base64; empty = contacts stored in plain text (dev only)
